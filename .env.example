PORT=4000
# Production behind Nginx: 127.0.0.1, so only the proxy can reach the app.
# HOST=127.0.0.1
NODE_ENV=development
# Sentry error tracking. Leave unset locally; set the project's DSN in production.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project-id>
# Comma-separated origins, without trailing slashes.
# Production: every frontend origin on the API's domain, e.g. https://yourdomain.com,https://www.yourdomain.com
CLIENT_ORIGIN=http://localhost:3000
# Keep 0 locally. Production: 1 behind Nginx, 2 with a Cloudflare proxy or load balancer in front of Nginx.
TRUST_PROXY=0
# RDS: append &sslmode=verify-full&sslrootcert=/path/to/rds-global-bundle.pem
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moving?schema=public"
# npm test only. Tests delete every row, so use a different database from DATABASE_URL.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moving_test?schema=public"
DUMMY_PASSWORD_HASH=

# Kakao
KAKAO_CLIENT_ID="발급받은_REST_API_키"
KAKAO_CLIENT_SECRET=발급받은_클라이언트_시크릿
KAKAO_CALLBACK_URL=http://localhost:4000/api/auth/kakao/callback

# Naver
NAVER_CLIENT_ID=발급받은_Client_ID
NAVER_CLIENT_SECRET=발급받은_Client_Secret
NAVER_CALLBACK_URL=http://localhost:4000/api/auth/naver/callback

# Google
NAVER_CLIENT_ID=발급받은_Client_ID
NAVER_CLIENT_SECRET=발급받은_Client_Secret
NAVER_CALLBACK_URL=http://localhost:4000/api/auth/naver/callback