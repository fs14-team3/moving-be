generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  MOVER

  @@map("user_role")
}

enum SocialProvider {
  GOOGLE
  KAKAO
  NAVER

  @@map("social_provider")
}

enum ServiceType {
  SMALL
  HOME
  OFFICE

  @@map("service_type")
}

enum ServiceLevel {
  BASIC
  HALF_PACKING
  FULL_PACKING

  @@map("service_level")
}

enum BuildingType {
  APARTMENT
  VILLA
  OFFICETEL
  HOUSE
  COMMERCIAL

  @@map("building_type")
}

enum AreaRange {
  UNDER_10
  TENS
  TWENTIES
  THIRTIES
  OVER_40

  @@map("area_range")
}

enum BoxRange {
  UP_TO_10
  UP_TO_20
  UP_TO_30
  UP_TO_50
  OVER_50

  @@map("box_range")
}

enum MoveRequestStatus {
  PENDING
  CONFIRMED
  COMPLETED
  EXPIRED

  @@map("move_request_status")
}

enum QuoteStatus {
  SUBMITTED
  CONFIRMED
  NOT_SELECTED

  @@map("quote_status")
}

enum MoveProgressStep {
  DEPARTED
  LOADING
  IN_TRANSIT
  UNLOADING
  COMPLETED

  @@map("move_progress_step")
}

enum NotificationType {
  NEW_DESIGNATED_REQUEST
  NEW_QUOTE
  QUOTE_CONFIRMED
  MOVE_DAY
  DAMAGE_REPORTED

  @@map("notification_type")
}

enum ReviewKeywordBaseKey {
  PUNCTUALITY
  PACKING
  HANDLING
  EFFICIENCY
  COMMUNICATION
  PRICE
  PROFESSIONALISM

  @@map("review_keyword_base_key")
}

enum ReviewKeywordSentiment {
  POSITIVE
  NEGATIVE
  UNCLEAR

  @@map("review_keyword_sentiment")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role         UserRole
  email        String?
  passwordHash String?  @map("password_hash")
  name         String?
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  socialAccounts     SocialAccount[]
  customerProfile    CustomerProfile?
  moverProfile       MoverProfile?
  notifications      Notification[]
  chatParticipations ChatParticipant[]
  sentMessages       Message[]

  @@unique([email, role], name: "email_role")
  @@map("users")
}

model SocialAccount {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  provider   SocialProvider
  providerId String         @map("provider_id")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("social_accounts")
}

model CustomerProfile {
  userId       String        @id @map("user_id") @db.Uuid
  imageUrl     String?       @map("image_url")
  serviceTypes ServiceType[] @map("service_types")
  regions      String[]
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  moveRequests MoveRequest[]
  favorites    Favorite[]

  @@map("customer_profiles")
}

model MoverProfile {
  userId             String              @id @map("user_id") @db.Uuid
  imageUrl           String?             @map("image_url")
  nickname           String?
  careerYears        Int?                @map("career_years")
  intro              String?
  description        String?
  serviceTypes       ServiceType[]       @map("service_types")
  regions            String[]
  reviewCount        Int                 @default(0) @map("review_count")
  averageRating      Decimal             @default(0) @map("average_rating") @db.Decimal(3, 2)
  confirmedCount     Int                 @default(0) @map("confirmed_count")
  favoriteCount      Int                 @default(0) @map("favorite_count")
  newRequestsSeenAt  DateTime            @default(now()) @map("new_requests_seen_at") @db.Timestamptz
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  designatedRequests DesignatedRequest[]
  quotes             Quote[]
  requestRejections  RequestRejection[]
  favorites          Favorite[]
  reviewSummary      ReviewSummary?

  @@map("mover_profiles")
}

model MoveRequest {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId         String              @map("customer_id") @db.Uuid
  moveType           ServiceType         @map("move_type")
  moveDate           DateTime            @map("move_date") @db.Date
  fromAddress        String              @map("from_address")
  fromZonecode       String?             @map("from_zonecode")
  fromRegion         String              @map("from_region")
  toAddress          String              @map("to_address")
  toZonecode         String?             @map("to_zonecode")
  toRegion           String              @map("to_region")
  serviceLevel       ServiceLevel?       @map("service_level")
  fromBuildingType   BuildingType?       @map("from_building_type")
  fromFloor          Int?                @map("from_floor")
  fromHasElevator    Boolean?            @map("from_has_elevator")
  fromCanPark        Boolean?            @map("from_can_park")
  toBuildingType     BuildingType?       @map("to_building_type")
  toFloor            Int?                @map("to_floor")
  toHasElevator      Boolean?            @map("to_has_elevator")
  toCanPark          Boolean?            @map("to_can_park")
  areaRange          AreaRange?          @map("area_range")
  residentCount      Int?                @map("resident_count")
  boxRange           BoxRange?           @map("box_range")
  memo               String?             @db.Text
  status             MoveRequestStatus   @default(PENDING)
  confirmedAt        DateTime?           @map("confirmed_at") @db.Timestamptz
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  customer           CustomerProfile     @relation(fields: [customerId], references: [userId], onDelete: Cascade)
  designatedRequests DesignatedRequest[]
  quotes             Quote[]
  requestRejections  RequestRejection[]
  notifications      Notification[]
  items              MoveRequestItem[]

  // Partial unique index on active requests is defined in the migration SQL.
  @@index([customerId])
  @@index([fromRegion, createdAt])
  @@index([toRegion, createdAt])
  @@map("move_requests")
}

model MoveRequestItem {
  moveRequestId String      @map("move_request_id") @db.Uuid
  item          String
  quantity      Int
  moveRequest   MoveRequest @relation(fields: [moveRequestId], references: [id], onDelete: Cascade)

  @@id([moveRequestId, item])
  @@map("move_request_items")
}

model DesignatedRequest {
  moveRequestId String       @map("move_request_id") @db.Uuid
  moverId       String       @map("mover_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  moveRequest   MoveRequest  @relation(fields: [moveRequestId], references: [id], onDelete: Cascade)
  mover         MoverProfile @relation(fields: [moverId], references: [userId], onDelete: Cascade)

  @@id([moveRequestId, moverId])
  @@map("designated_requests")
}

model Quote {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moveRequestId String         @map("move_request_id") @db.Uuid
  moverId       String         @map("mover_id") @db.Uuid
  price         Int
  comment       String?        @db.Text
  isDesignated  Boolean        @default(false) @map("is_designated")
  status        QuoteStatus    @default(SUBMITTED)
  confirmedAt   DateTime?      @map("confirmed_at") @db.Timestamptz
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  moveRequest   MoveRequest    @relation(fields: [moveRequestId], references: [id], onDelete: Cascade)
  mover         MoverProfile   @relation(fields: [moverId], references: [userId], onDelete: Cascade)
  reviews       Review[]
  proofPhotos   ProofPhoto[]
  progress      MoveProgress[]
  damageReports DamageReport[]
  notifications Notification[]
  chatRoom      ChatRoom?

  // Partial unique index on confirmed quotes is defined in the migration SQL.
  @@index([moveRequestId, moverId])
  @@map("quotes")
}

model RequestRejection {
  moveRequestId String       @map("move_request_id") @db.Uuid
  moverId       String       @map("mover_id") @db.Uuid
  reason        String?      @db.Text
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  moveRequest   MoveRequest  @relation(fields: [moveRequestId], references: [id], onDelete: Cascade)
  mover         MoverProfile @relation(fields: [moverId], references: [userId], onDelete: Cascade)

  @@id([moveRequestId, moverId])
  @@map("request_rejections")
}

model Review {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId         String                 @unique @map("quote_id") @db.Uuid
  rating          Int
  content         String
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  quote           Quote                  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  keywordMentions ReviewKeywordMention[]
  keywordAnalysis ReviewKeywordAnalysis?
  keywordRecovery ReviewKeywordRecovery?

  @@map("reviews")
}

model ProofPhoto {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId      String    @map("quote_id") @db.Uuid
  uploadId     String    @map("upload_id") @db.Uuid
  imageKey     String    @map("image_key")
  thumbnailKey String    @map("thumbnail_key")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  quote        Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, uploadId])
  @@index([quoteId, createdAt, id])
  @@map("proof_photos")
}

model MoveProgress {
  quoteId    String           @map("quote_id") @db.Uuid
  step       MoveProgressStep
  recordedAt DateTime         @default(now()) @map("recorded_at") @db.Timestamptz
  quote      Quote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@id([quoteId, step])
  @@map("move_progress")
}

model DamageReport {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId     String        @map("quote_id") @db.Uuid
  itemName    String        @map("item_name")
  description String        @db.Text
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  quote       Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  photos      DamagePhoto[]

  @@index([quoteId, createdAt, id])
  @@map("damage_reports")
}

model DamagePhoto {
  reportId     String       @map("report_id") @db.Uuid
  position     Int
  uploadId     String       @map("upload_id") @db.Uuid
  imageKey     String       @map("image_key")
  thumbnailKey String       @map("thumbnail_key")
  report       DamageReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@id([reportId, position])
  @@map("damage_photos")
}

model Favorite {
  customerId String          @map("customer_id") @db.Uuid
  moverId    String          @map("mover_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  customer   CustomerProfile @relation(fields: [customerId], references: [userId], onDelete: Cascade)
  mover      MoverProfile    @relation(fields: [moverId], references: [userId], onDelete: Cascade)

  @@id([customerId, moverId])
  @@map("favorites")
}

model Notification {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  type          NotificationType
  message       String?
  payload       Json             @default("{}") @db.JsonB
  moveRequestId String?          @map("move_request_id") @db.Uuid
  quoteId       String?          @map("quote_id") @db.Uuid
  readAt        DateTime?        @map("read_at") @db.Timestamptz
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  moveRequest   MoveRequest?     @relation(fields: [moveRequestId], references: [id], onDelete: Cascade)
  quote         Quote?           @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt, id])
  @@index([userId, createdAt, id])
  @@map("notifications")
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("session")
}

model ChatRoom {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId       String    @unique @map("quote_id") @db.Uuid
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  quote        Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  participants ChatParticipant[]
  messages     Message[]

  @@map("chat_rooms")
}

model ChatParticipant {
  chatRoomId String    @map("chat_room_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  lastReadAt DateTime? @map("last_read_at") @db.Timestamptz

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatRoomId, userId])
  @@index([userId, chatRoomId])
  @@map("chat_participants")
}

model Message {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatRoomId String   @map("chat_room_id") @db.Uuid
  senderId   String   @map("sender_id") @db.Uuid
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender   User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatRoomId, createdAt, id])
  @@map("messages")
}

model ReviewSummary {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moverId     String       @unique @map("mover_id") @db.Uuid
  reviewCount Int          @map("review_count")
  summary     String
  aspects     Json
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  mover       MoverProfile @relation(fields: [moverId], references: [userId], onDelete: Cascade)

  @@map("review_summaries")
}

model ReviewKeyword {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String                @unique
  description   String?
  baseKey       ReviewKeywordBaseKey? @unique @map("base_key")
  parentBaseKey ReviewKeywordBaseKey? @map("parent_base_key")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz

  mentions ReviewKeywordMention[]

  @@map("review_keywords")
}

model ReviewKeywordMention {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId  String                 @map("review_id") @db.Uuid
  keywordId String                 @map("keyword_id") @db.Uuid
  sentiment ReviewKeywordSentiment
  evidence  String                 @db.Text
  start     Int
  end       Int
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz

  review  Review        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  keyword ReviewKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([reviewId, keywordId])
  @@index([keywordId, reviewId])
  @@map("review_keyword_mentions")
}

model ReviewKeywordAnalysis {
  reviewId        String   @id @map("review_id") @db.Uuid
  reviewUpdatedAt DateTime @map("review_updated_at") @db.Timestamptz
  analyzedAt      DateTime @default(now()) @map("analyzed_at") @db.Timestamptz

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_keyword_analyses")
}

model ReviewKeywordRecovery {
  reviewId      String    @id @map("review_id") @db.Uuid
  attempts      Int       @default(0)
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_keyword_recoveries")
}
